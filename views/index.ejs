<html>
	<body>
    <ul>
    <% if (locals.messages) {%>
    <% messages.map((message) => { %>
      <li>user: <%= message.username %> 
      <li>message: '<%= message.text %>' </li> 
      <li>added: <%= message.added %></li>
      <button><a href="/message/<%= message.id %>">Expand</a></button></li>

    <% })%></ul>
    <% } %>
   <a href="/new">New Message</a>
  </body>
</html>
